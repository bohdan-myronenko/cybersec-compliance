# OLLAMA SETTINGS
# TO GET MODELS, RUN: $ docker exec ollama ollama pull <model name>
OLLAMA_BASE_URL="http://ollama:11434"
EMBED_MODEL="nomic-embed-text"
LLM_MODEL="llama3.1:8b"

# EXTERNAL API FOR DEVELOPMENT
API_MODE="LOCAL"   # EXTERNAL - use API, LOCAL - use Ollama
API_URL="https://api.openai.com/v1/chat/completions"
# "https://llm.chutes.ai/v1/chat/completions"


# YOUR API KEY FOR THE CURRENT MODEL PROVIDER (IGNORED IF API_MODE=LOCAL)
API_KEY="0"
API_MODEL="gpt-5.4-nano"

# PIPELINE SETTINGS
WINDOW_DAYS=90       # or 1, 30, etc.
LOG_FORMAT=rba         # optional: jsonl, csv, syslog, unknown

# INDEX SETTINGS
DEFAULT_DATA_DIR="/data"
DEFAULT_INDEX_DIR="/index"
CHUNK_SIZE=1200       # characters per chunk
CHUNK_OVERLAP=200     # overlap between chunks
TOP_K=6               # retrieved chunks
MAX_CONTEXT_CHARS=100000  # final context size cap for prompt

# MODE
# USAGE:    "index" = build index based on the data provided
#           "chat" = use QUESTION or QUESTION_FILE as input to the model with embeddings.
#           "cycle" = build AND prompt.
MODE="cycle"

SYSTEM_PROMPT="You are a cybersecurity compliance report writer. Your ONLY source of truth is the LEGAL TEXTS and METRICS JSON provided in each request. STRICT RULES: 1) Base every claim exclusively on the provided context — never use prior knowledge about NIS2 or any regulation. 2) Cite the specific article or clause for every obligation you mention, using bracket notation (e.g., [NIS2 Art. 21(2)(i)]). 3) If the provided context does not contain information to answer a point, explicitly state 'No data available in the provided evidence' — do NOT guess or fabricate. 4) Report quantitative findings (metrics) exactly as given; do not round, extrapolate, or editorialize numbers. 5) Write in formal, third-person compliance language suitable for audit review. 6) Keep each bullet or finding concise (<= 30 words) and traceable to a source document or metric."


# LLM-as-a-judge notebook
ANTHROPIC_API_KEY="0"
OPENAI_API_KEY="0"
GOOGLE_API_KEY="0"